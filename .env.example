# Copy to .env and fill in. .env is git-ignored. Never commit real secrets.

# Demo mode: shows demo persona buttons on login, demo controls for admin, simulated clock.
DEMO_MODE=true

# Session signing secret (JWT HS256). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If empty, a random secret is generated per process start (sessions reset on restart).
SECRET_KEY=

# Session lifetime in minutes (idle timeout).
SESSION_MINUTES=60

# Database. Default is SQLite in backend/data/duly.db. Postgres-ready, e.g.:
#   DATABASE_URL=postgresql+psycopg://duly:duly@localhost:5432/duly
DATABASE_URL=

# AES-GCM key (base64, 32 bytes) for encrypting bank details at rest. Generate with:
#   python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# If empty in DEMO_MODE, a fixed demo key is derived (demo data only, never production).
DATA_ENCRYPTION_KEY=

# Claude API (optional). Without a key the app runs in offline mode (OCR + regex parser).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# AI_MODE: auto (live if a key is set, else offline) | live | cached (replay backend/data/ai_cache, no
# network: pre-warm online, then demo offline) | offline (AI kill switch: OCR + regex parser only).
AI_MODE=auto

# CORS origin of the frontend dev server.
FRONTEND_ORIGIN=http://localhost:5173
